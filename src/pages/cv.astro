    <div class="grid md:grid-cols-2 gap-6">
      <div>
        <h3 class="text-xl font-semibold mb-3">Languages</h3>
        <ul class="space-y-2">
          <li><strong>English:</strong> Native/Fluent</li>
          <li><strong>Hausa:</strong> Fluent</li>
        </ul>
      </div>
      <div>
        <h3 class="text-xl font-semibold mb-3">Work Preferences</h3>
