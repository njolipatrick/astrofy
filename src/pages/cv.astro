      <span class="text-sm ml-2">- Professional development and workplace skills</span>
    </li>
  </ul>

  <!-- Volunteer & Community -->
  <div class="mb-8">
    <h2 class="text-3xl w-full font-bold mb-4">Community Involvement & Leadership</h2>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement title="2023 - Present">
