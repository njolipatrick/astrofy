---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout 
  title="404 - Page Not Found | Patrick Timothy Njoli" 
  description="The page you're looking for doesn't exist. Return to Patrick Njoli's portfolio homepage to explore backend development insights and projects."
  sideBarActiveItemID=""
>
  <div class="text-center py-20">
    <h1 class="text-6xl font-bold mb-4">404</h1>
    <h2 class="text-3xl mb-4">Page Not Found</h2>
    <p class="text-lg mb-8 max-w-2xl mx-auto">
      Sorry, the page you're looking for doesn't exist or has been moved. 
      Perhaps you'd like to check out my latest blog posts about Node.js and NestJS, 
      or view my work experience?
    </p>
    <div class="flex gap-4 justify-center flex-wrap">
      <a href="/" class="btn btn-primary">Go Home</a>
      <a href="/blog" class="btn btn-outline">View Blog</a>
      <a href="/cv" class="btn btn-outline">View Resume</a>
      <a href="/projects" class="btn btn-outline">View Projects</a>
    </div>
  </div>
</BaseLayout>
